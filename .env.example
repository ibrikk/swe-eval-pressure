# Scale LiteLLM gateway. Never commit real keys.
# Legacy/single-key mode remains supported.
export LITE_LLM_KEY=""
# Optional arbitrary-size pool. When non-empty it takes precedence over LITE_LLM_KEY.
# Example: export LITE_LLM_KEYS="key1,key2,key3"
export LITE_LLM_KEYS=""
# Per-key TPM quota used only to choose conservative client-side defaults/reporting.
# The gateway's actual HTTP 429/reset response remains authoritative.
# Keep 200000 for older keys; set 5000000 for the upgraded Scale keys.
export LITE_LLM_TPM_LIMIT=200000
export LITE_LLM_URL=https://litellm-proxy.ml.scale.com/v1
export LITE_LLM_URL_ANTHROPIC=https://litellm-proxy.ml.scale.com

# Agent profiles.
export CLAUDE_AGENT=claude-code
export CLAUDE_MODEL=anthropic/claude-opus-4-8
export CLAUDE_INSTRUCTION_FILE=CLAUDE.md

export FABLE_AGENT=claude-code
export FABLE_MODEL=anthropic/claude-fable-5
export FABLE_INSTRUCTION_FILE=CLAUDE.md

export CODEX_AGENT=custom_agents.bootstrap_compatible_codex:BootstrapCompatibleCodex
export CODEX_MODEL=openai/gpt-5.6
export CODEX_INSTRUCTION_FILE=AGENTS.md
# Reproducibility pin for the benchmark handoff; do not use Harbor's moving @latest in production.
export CODEX_VERSION="0.147.0"

# Llama uses Mini-SWE's text command parser rather than provider-native tool calling.
export LLAMA_AGENT=custom_agents.bootstrap_compatible_llama:BootstrapCompatibleLlamaTextBasedMiniSweAgent
export LLAMA_MODEL=openai/llmengine/llama-3-3-70b-instruct
export LLAMA_INSTRUCTION_FILE=AGENTS.md
export MINI_SWE_VERSION=2.4.5
export MINI_SWE_LITELLM_VERSION=1.83.0

# Benchmark factors.
export CUE_ASSIGNMENT_SEED=20260805
export FINANCIAL_MESSAGE_INDEX=3
export SELF_PRESERVATION_MESSAGE_INDEX=5

# Resource-deprivation follow-up.
export RESOURCE_DEPRIVATION_MESSAGE_INDEX=10
export RESOURCE_TASK_COUNT=70

# Profiles and dataset selection.
export PROFILES="claude fable codex llama"
export PILOT_TASK_COUNT=4
export SAMPLE_TASK_COUNT=10

# SWE-Atlas normally runs with network access. Set false for a network-disabled ablation.
export ALLOW_INTERNET=true

# Harbor execution.
export HARBOR_REPEATS=1
export HARBOR_CONCURRENCY=1

# Multi-profile matrix concurrency. `custom` uses the four values below.
# Existing 200k keys remain supported:
#   ./lab.sh matrix full --concurrency-preset scale-200k
# Upgraded 5M keys can use the higher-throughput starting preset:
#   LITE_LLM_TPM_LIMIT=5000000 ./lab.sh matrix full --concurrency-preset scale-5m
# With LITE_LLM_KEYS, these values apply per key and task shards run across keys.
export MATRIX_CONCURRENCY_PRESET=custom
export CLAUDE_CONCURRENCY=1
export FABLE_CONCURRENCY=1
export CODEX_CONCURRENCY=1
export LLAMA_CONCURRENCY=1
export MODAL_VM_RUNTIME=true
export HARBOR_DISABLE_VERIFICATION=0
export AUTO_ANALYZE=0

# Analysis is run explicitly with ./lab.sh analyze. The LLM semantic judge is
# enabled by default and cached; set to 0 or pass --no-semantic to disable it.
export ANALYSIS_USE_LLM=1
export ANALYSIS_MODEL=openai/gpt-5.6
export ANALYSIS_MAX_CHARS=60000
export ANALYSIS_MAX_RETRIES=3
# Leave unset for automatic workers: 3/key at <=200k TPM, 12/key at >=5M TPM,
# capped at 64 total. Set explicitly to override.
# export ANALYSIS_SEMANTIC_WORKERS=12
